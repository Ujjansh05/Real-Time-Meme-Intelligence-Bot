# Set these as process or hosting environment variables. Do not commit real values.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# For local AI instead, set AI_PROVIDER=ollama and install the model with Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Use memory only for single-process local testing. Public use should use Upstash.
QUOTA_BACKEND=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_SECRET=
ALLOWED_ORIGINS=
AI_DISABLED=false
TRUST_PROXY_HEADERS=false
SESSION_DAILY_LIMIT=5
IP_DAILY_LIMIT=20
GLOBAL_DAILY_LIMIT=100

# Optional live source integrations. Reddit must be approved first.
REDDIT_API_APPROVED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=HumourHubTrends/2.0 (contact: your-address)
REDDIT_COMMUNITIES=memes,dankmemes
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_QUERIES=meme,memes
